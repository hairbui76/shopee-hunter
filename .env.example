# shopee-hunter configuration template.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_ENV=development                 # development | production
LOG_LEVEL=info                      # trace | debug | info | warn | error
LOG_FORMAT=pretty                   # pretty | json

# --- Database ---
# SQLite for local development:
DATABASE_URL=sqlite://data/shopee-hunter.db?mode=rwc
# PostgreSQL for production:
# DATABASE_URL=postgres://shopee_hunter:CHANGE_ME@localhost:5432/shopee_hunter
DATABASE_MAX_CONNECTIONS=5

# --- Shopee ---
SHOPEE_BASE_URL=https://shopee.vn
SHOPEE_PROFILE_PATH=/var/lib/shopee-hunter/browser-profile
SHOPEE_REQUEST_TIMEOUT_MS=10000
SHOPEE_CONNECT_TIMEOUT_MS=5000

# --- Session ---
SESSION_HEALTH_INTERVAL_SECS=300
SESSION_COOKIE_STORE_PATH=/var/lib/shopee-hunter/session/cookies.enc
ENABLE_BROWSER_SESSION_REFRESH=false

# --- Collectors ---
COLLECTOR_DEFAULT_INTERVAL_SECS=120
COLLECTOR_TIMEOUT_SECS=30
COLLECTOR_MAX_CONCURRENCY=4
ENABLE_SHOPEE_PAGE_COLLECTOR=false
ENABLE_EXTERNAL_FEED_COLLECTOR=false
ENABLE_MANUAL_COLLECTOR=true
ENABLE_REPLAY_COLLECTOR=false
REPLAY_FIXTURE_DIR=tests/fixtures/replay

# --- Scheduler ---
SCHEDULER_COARSE_TICK_SECS=15
SCHEDULER_PREFLIGHT_SECS=600
SCHEDULER_PRECISION_WINDOW_SECS=10
SCHEDULER_STALE_AFTER_SECS=300

# --- Claim ---
ENABLE_AUTO_CLAIM=false
CLAIM_MAX_RETRIES=3
CLAIM_RETRY_BASE_DELAY_MS=500
CLAIM_MIN_SCORE=0

# --- Telegram ---
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=123456:CHANGE_ME
TELEGRAM_CHAT_ID=123456789
TELEGRAM_ADMIN_CHAT_IDS=123456789

# --- Observability / admin ---
HEALTHCHECK_BIND_ADDR=127.0.0.1:8686
METRICS_ENABLED=true
